{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main", "moonlight-stream"],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "opener:default",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default"
  ]
}
